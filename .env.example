PORT=3000

# Database
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=your_local_password
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

DATABASE_URL="postgresql://taskflow:your_local_password@localhost:5432/taskflow?schema=public"

# Generate separate secrets with: openssl rand -base64 32
# Replace both placeholders with independently generated values (minimum 32 bytes).
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
CSRF_SECRET=replace_with_a_different_random_secret_at_least_32_bytes
