// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects      Project[]
  projectMemberships ProjectMember[]
  createdAssignments TaskAssignment[] @relation("AssignmentCreator")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members    ProjectMember[]
  tasks      Task[]
  categories Category[]

  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRole
  joinedAt  DateTime    @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskAssignments TaskAssignment[]

  @@unique([userId, projectId])
  @@index([projectId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  projectId   String
  categoryId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId, projectId], references: [id, projectId], onDelete: Restrict)
  assignments TaskAssignment[]

  @@unique([id, projectId])
  @@index([projectId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks   Task[]
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([id, projectId])
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  projectId  String
  assignedAt DateTime @default(now())
  assignedBy String?

  task       Task          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  membership ProjectMember @relation(fields: [userId, projectId], references: [userId, projectId], onDelete: Cascade)
  assigner   User?         @relation("AssignmentCreator", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([taskId, userId])
  @@index([userId, projectId])
}

enum ProjectRole {
  MEMBER
  ADMIN
  OWNER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
