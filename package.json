{
    "name": "task-flow",
    "version": "1.0.0",
    "packageManager": "pnpm@12.21.0",
    "description": "A task management REST API built with Node.js, TypeScript, Express, and PostgreSQL.",
    "homepage": "https://github.com/erfan-paya/task-flow#readme",
    "bugs": {
        "url": "https://github.com/erfan-paya/task-flow/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/erfan-paya/task-flow.git"
    },
    "author": "Erfan Paya",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/src/server.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "prisma": "^7.10.1",
        "tsc-alias": "^1.9.10",
        "tsx": "^4.23.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.2"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "pg": "^8.23.1"
    }
}
