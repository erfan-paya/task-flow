{
    "name": "task-flow",
    "version": "1.0.0",
    "packageManager": "pnpm@12.21.0",
    "description": "A task management REST API built with Node.js, TypeScript, Express, and PostgreSQL.",
    "homepage": "https://github.com/erfan-paya/task-flow#readme",
    "bugs": {
        "url": "https://github.com/erfan-paya/task-flow/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/erfan-paya/task-flow.git"
    },
    "author": "Erfan Paya",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/src/server.js",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "prisma": "^7.10.1",
        "tsc-alias": "^1.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "argon2": "^0.45.2",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    }
}
